 "history": [
  {
   "version": "1.3.0",
   "date": "2026-10-18",
   "notes": [
    "AI で歌詞を聞き取る機能（オンにしたときだけ。初回に AI モデルをダウンロード）",
    "入力した歌詞のタイミングを、AI の聞き取りに合わせて自動で調整",
    "歌詞を入れていない曲は、AI が聞き取った仮の歌詞を表示（あとで正しい歌詞に置き換え可能）"
   ]
  },
  {
   "version": "1.2.0",
   "date": "2026-10-17",
   "notes": [
    "歌詞の表示を追加（楽譜の下に歌詞の段。カラオケのように色が変わる）",
    "歌詞を貼り付けると、ふりがなを自動で調べてお手本バーに1音ずつ割り当て",
    "行の歌い出しを Enter で記録して、タイミングを合わせる機能",
    "歌詞の文字をドラッグ・右クリックでタイミングやふりがなを直せる",
    "時間つき歌詞 (.lrc) の読み込み・保存"
   ]
  },
  {
   "version": "1.1.0",
   "date": "2026-10-15",
   "notes": [
    "ビルド版 (PitchLuna.exe) に対応（Python なしでダブルクリックで起動）",
    "ウィンドウに三日月と音符のアイコン",
    "取扱説明書にビルド版の使い方を追加"
   ]
  },
  {
   "version": "1.0.0",
   "date": "2026-10-15",
   "notes": [
    "最初の公開版（GitHub からのアップデートに対応）",
    "ヘルプ → アップデートを確認 / ファイル (ZIP) からアップデート / バージョン情報"
   ]
  }
 ],
 "download_url": "https://github.com/shellbe1967/pitch-luna/releases/latest"
